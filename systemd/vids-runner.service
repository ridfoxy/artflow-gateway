[Unit]
Description=Vids Runner (gateway 104.64.15.167) — Google Vids generate + download
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/api-google-flow
Environment=DISPLAY=:99
Environment=PYTHONUNBUFFERED=1
Environment=VIDS_MAX_CONCURRENT=3
Environment=VIDS_MAX_CONTEXTS=3
Environment=VIDS_MIN_FREE_MB=300
Environment=VIDS_ZERO_UI=1
Environment=VIDS_GEN_TIMEOUT=240
Environment=VIDS_UI_WAIT=75
Environment=VIDS_UI_PROBE=14
ExecStart=/root/geminiomni/venv/bin/python vids_runner.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
KillMode=control-group
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target